#!/bin/sh
# Pre-commit hook: lint with gallant when a model API key is available.

if [ -z "${OPENCODE_API_KEY:-}" ]; then
	echo "gallant: OPENCODE_API_KEY is not set, skipping lint checks"
	exit 0
fi

echo "gallant: running lint checks"
if ! out=$(go run ./cmd/gallant ./rules ./eval ./cmd); then
	echo "gallant: lint run failed"
	exit 1
fi
if [ -n "$out" ]; then
	printf '%s\n' "$out"
	echo "gallant: lint findings above, commit blocked"
	exit 1
fi
